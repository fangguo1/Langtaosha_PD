# Empty VITE_API_BASE_URL means the frontend calls same-origin /api,
# and Vite proxies /api to the backend during development.
VITE_API_BASE_URL=
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5173
# Optional. Required only when the backend enables API_AUTH_TOKEN(S)
# and the Vite proxy needs to call protected /api routes.
VITE_BACKEND_API_TOKEN=
